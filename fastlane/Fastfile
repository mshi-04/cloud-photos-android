default_platform(:android)

platform :android do
  # Remove the iOS-specific Xcode command line tools section that fastlane's
  # built-in README template unconditionally emits. This hook runs after every
  # lane so that `fastlane/README.md` stays Android-only regardless of when it
  # was last regenerated.
  after_all do
    readme_path = File.join(File.dirname(__FILE__), "README.md")
    next unless File.exist?(readme_path)

    content = File.read(readme_path)
    content.gsub!(/Make sure you have the latest version of the Xcode command line tools installed:\s*\n\s*```sh\s*\n\s*xcode-select --install\s*\n\s*```\s*\n/, "")
    File.write(readme_path, content)
  end

  def env_properties(prefix)
    {
      "#{prefix}_API_BASE_URL" => ENV.fetch("#{prefix}_API_BASE_URL"),
      "#{prefix}_COGNITO_CLIENT_ID" => ENV.fetch("#{prefix}_COGNITO_CLIENT_ID"),
      "#{prefix}_S3_BUCKET_NAME" => ENV.fetch("#{prefix}_S3_BUCKET_NAME")
    }
  end

  def dev_properties
    env_properties("DEV")
  end

  def prod_properties
    env_properties("PROD")
  end

  desc "Run ktlint and detekt (used in CI)"
  lane :lint do
    gradle(task: "ktlintCheck detekt", print_command: false)
  end

  desc "Run Unit Tests (used in CI)"
  lane :test do
    gradle(task: "testDevDebugUnitTest", properties: dev_properties, print_command: false)
  end

  desc "Build the DEV environment APK (used in CD)"
  lane :build_dev do
    gradle(task: "assemble", flavor: "Dev", build_type: "Release", properties: dev_properties, print_command: false)
  end

  desc "Build the PROD environment APK and AAB (used in CD)"
  lane :build_prod do
    gradle(task: "assemble", flavor: "Prod", build_type: "Release", properties: prod_properties, print_command: false)
    gradle(task: "bundle", flavor: "Prod", build_type: "Release", properties: prod_properties, print_command: false)
  end
end
